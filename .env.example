# LinkForge Environment Configuration

# Required: PostgreSQL connection string
# For Docker Compose VPS setup:
DATABASE_URL="postgresql://linkforge:change-me-postgres-password@db:5432/linkforge?schema=public"

# Required for Docker Compose database container:
POSTGRES_PASSWORD="change-me-postgres-password"

# Required: Cryptographically secure 64-char hex secret (generate with: openssl rand -hex 32)
ADMIN_API_KEY="replace-with-a-long-random-secret"

# Canonical public origin used when generating, copying, and displaying short URLs & QR codes
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Port configuration (defaults to 3000)
PORT=3000
